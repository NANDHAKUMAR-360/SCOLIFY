# ==================================================
# SCOLIFY ENVIRONMENT VARIABLES (EXAMPLE)
# ==================================================

# --------------------------------------------------
# FRONTEND PUBLIC VARIABLES (VITE_)
# Exposed to browser - DO NOT put secret keys here!
# --------------------------------------------------
VITE_APP_NAME="Scolify"
VITE_APP_TAGLINE="Find Your Next Opportunity"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# --------------------------------------------------
# BACKEND SERVER & SECRET VARIABLES
# Kept safely on server - NEVER expose to frontend!
# --------------------------------------------------
PORT=5000
NODE_ENV=development

# Supabase Admin / Service Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Infrastructure
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Security & CORS Configuration
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key-change-in-production"

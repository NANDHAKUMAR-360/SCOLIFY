{
  "name": "scolify-server",
  "version": "1.0.0",
  "private": true,
  "description": "Scolify Express API Server & AI Orchestrator Foundation",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "tsx src/tests/part04_ingestion_verification.test.ts && tsx src/tests/part05_eligibility_engine.test.ts && tsx src/tests/part06_match_engine.test.ts && tsx src/tests/part07_document_intelligence.test.ts",
    "test:part06": "tsx src/tests/part06_match_engine.test.ts",
    "test:part07": "tsx src/tests/part07_document_intelligence.test.ts"
  },

  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^0.15.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
